# Bhojpatra environment variables.
#
# Copy this file to `.env.local` and fill in the values to run against the real
# Neon database + Vercel Blob locally. Leaving them blank is fine — the app
# falls back to the JSON files under `data/` for local dev.
#
# On Vercel these are injected automatically by the Neon and Blob integrations,
# so you do NOT set them in the dashboard by hand.

# Neon Postgres connection string (created by the Neon integration).
DATABASE_URL=

# Vercel Blob read/write token (created by the Blob integration) — used for
# vendor KYC file uploads.
BLOB_READ_WRITE_TOKEN=

# ── Emails via Resend ──────────────────────────────────────────────────────
# When set, every new customer submission (booking, payment, lead, vendor
# application, partner signup, venue listing) emails a summary to the owners.
# New bookings also send a confirmation to the signed-in customer's email.
# Leave RESEND_API_KEY blank to disable — submissions still work, just no email.
#
# API key from resend.com.
RESEND_API_KEY=
# Comma-separated recipients. Defaults to both owners if left blank.
ALERT_EMAIL_TO=ankit23690@gmail.com,sohni2012@gmail.com
# Sender. Resend's test sender (onboarding@resend.dev) only delivers to the
# Resend account's own email — verify a domain to reach BOTH recipients, then
# set this to an address on that domain, e.g. "Bhojpatra <alerts@yourdomain>".
ALERT_EMAIL_FROM=
# Public origin used to build the invoice link in the order email. In production
# on Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically if this is blank.
SITE_URL=

# ── Location detection (optional) ──────────────────────────────────────────
# Reverse geocoding works out of the box via OpenStreetMap Nominatim — no key
# needed. On Vercel, IP-based city hints also work automatically.
#
# Optional: set GOOGLE_MAPS_API_KEY to prefer Google Geocoding when available.
# GOOGLE_MAPS_API_KEY=
# Optional: custom User-Agent string for Nominatim requests.
# NOMINATIM_USER_AGENT=

# ── Authentication ─────────────────────────────────────────────────────────
# Secret used to sign the session cookie (HMAC). REQUIRED in production — set a
# long random value (e.g. `openssl rand -base64 32`). In local dev an insecure
# fallback is used if this is blank.
SESSION_SECRET=

# Bootstrap admin account. On the first admin login the app seeds this user.
# In production set ADMIN_EMAIL and ADMIN_PASSWORD_HASH (a scrypt hash — never a
# plaintext password). Generate the hash with:
#   node -e "import('./src/lib/auth.ts')" is not runnable directly; instead run
#   the app once locally with ADMIN_PASSWORD set (dev only) to hash on the fly,
#   or compute a scrypt hash of the form scrypt$N$r$p$<saltB64>$<keyB64>.
# In local dev, if these are blank a default admin is seeded:
#   admin@bhojpatra.local / admin123
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Dev-only convenience: a plaintext password hashed on the fly at seed time.
# Ignored in production (use ADMIN_PASSWORD_HASH there).
ADMIN_PASSWORD=
