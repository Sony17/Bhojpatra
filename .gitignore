# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Captured lead submissions (runtime data store)
/data/leads.json

# Uploaded KYC documents + their metadata index (runtime data store)
/data/kyc/
/data/kyc-documents.json

# Recorded UPI payments + merchant UPI config (runtime data store)
/data/payments.json
/data/payment-settings.json

# Auth users + active sessions (runtime data store — contains password
# hashes and live session tokens; never commit)
/data/users.json
/data/sessions.json

# Admin-editable CMS content (runtime data store — seeded from code defaults)
/data/content-items.json

# Live vendor profiles + menus (runtime data store — seeded from code defaults)
/data/vendors.json

# Uploaded vendor card photos + their metadata index (runtime data store)
/data/vendor-photos/
/data/vendor-photos.json

# Agent skills
.agents/skills/

# Local scratch and test scripts
/scratch/
